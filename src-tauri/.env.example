# Copy this file to .env and fill in your own values.
# .env is git-ignored — these are the app's OAuth credentials, shared by every
# install of SnaitySoft Polls, never entered by end users.
#
# Before building a release: run `cargo run --example encrypt_env` (from src-tauri/) to
# produce .env.enc — that's the file that actually gets bundled into the app, encrypted,
# instead of shipping this as a plain-text resource. Re-run it whenever .env changes.
# The encryption key itself (.enc_key) is generated automatically by build.rs on first
# `cargo build`/`check` — nothing to set up manually, just don't commit it (git-ignored).

# https://dev.twitch.tv/console/apps — client type "Public" (no secret).
# Uses the Device Code Grant Flow — no redirect URL needs to be registered.
TWITCH_CLIENT_ID=

# https://kick.com/settings/developer — redirect URI: http://localhost:9898/oauth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
